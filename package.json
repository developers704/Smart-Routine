{
  "name": "routine",
  "version": "1.0.0",
  "private": true,
  "description": "Shift-aware hospital calendar PWA",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "test": "node tests/scheduler.check.js && node tests/alarms.check.js && node tests/travel.check.js",
    "cap:sync": "npx cap sync",
    "cap:ios": "npx cap sync ios && node scripts/patch-ios.mjs && npx cap open ios",
    "cap:android": "npx cap sync android && npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/keyboard": "^6.0.3",
    "@capacitor/local-notifications": "^6.1.2",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
