# Copy to .env on the VPS (never commit .env). pm2 ecosystem env works too.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
PORT=4173
# Optional: move persisted state elsewhere (defaults to ./data)
# ROUTINE_DATA_DIR=/var/lib/smart-routine
# Family login hashes (scrypt). Generate with: node scripts/hash-password.mjs
# Temporary test password for kash, aanika, and owais is 123456. Replace these hashes.
FAMILY_KASH_PASSWORD_HASH=scrypt$16384$8$1$88zMaUYCy+6ktyj8kgmGcw==$ymcKRqScL64DLg8/rSWlfku0XE3DYIQ6zp8kob8Nqug=
FAMILY_ANIKA_PASSWORD_HASH=scrypt$16384$8$1$uYZTbmOZjJ65j30SzjOQWA==$l7UFynlZQ//XTTdZWRL6GMFSQS4K/eawFu0XfO+8BqU=
FAMILY_OWAIS_PASSWORD_HASH=scrypt$16384$8$1$p/ecRUgZY7FkZ7+5SZA0ZA==$aiOl2aqXpT25hf9dPjdm1GgFFhHnOCcsHQjaMRLpAME=
# Kash's master password - also signs into Aanika's or Owais's account (their own password
# still works too). No default: leave empty and master-password sign-in stays off. Generate
# with node scripts/hash-password.mjs and set it directly in .env on the VPS - never commit it.
FAMILY_MASTER_PASSWORD_HASH=
# Native APNs (Kash’s installed iPhone). Leave empty to use Web Push only.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=app.routine.calendar
APNS_KEY_FILE=
# APNS_KEY_P8=
APNS_PRODUCTION=0
